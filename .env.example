# Server-only configuration. Copy to .env locally; leave this template empty.
# Never rename these with a VITE_ prefix; that would expose them to browser code.
MUSE_API_KEY=
AI3D_API_KEY=
GEMINI_API=
SUBQ_API=
AGENTVERSE_API_KEY=
# Used by Run live and the optional evaluation CLI (ASI:One planner).
FETCH_ASI_API=
DARKMATTER_EBERT_AGENT_ADDRESS=
DARKMATTER_SPIELBERG_AGENT_ADDRESS=
DARKMATTER_LUCAS_AGENT_ADDRESS=
DARKMATTER_BOHR_AGENT_ADDRESS=

# Native /ebert and /agentverse endpoints are routed through ASI:One to the exact
# configured Agentverse address. Other endpoints use the app's JSON adapter contract.
DARKMATTER_SPIELBERG_ENDPOINT=
DARKMATTER_EBERT_ENDPOINT=
DARKMATTER_LUCAS_ENDPOINT=
DARKMATTER_BOHR_ENDPOINT=
# For another native Agentverse URL, declare its transport explicitly:
# DARKMATTER_EBERT_TRANSPORT=agentverse
# Optional shared token for your adapter endpoints. This is separate from the Agentverse management key.
DARKMATTER_AGENT_TOKEN=
# Public live calls require a separate owner-controlled demo key; never a provider key.
DARKMATTER_LIVE_ACCESS_TOKEN=
